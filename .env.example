# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored - never commit real values.
# ---------------------------------------------------------------------------

# --- Required at runtime ---------------------------------------------------

# Neon Postgres connection string (Neon dashboard -> Connect -> Show password)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Shared secret authenticating the Vapi webhook. Any long random string; the
# same value goes in the Vapi tool's `x-vapi-secret` header.
VAPI_WEBHOOK_SECRET=change-me-to-a-long-random-string

PORT=3000

# --- Needed only by `python scripts/vapi_setup.py` --------------------------

# Vapi dashboard -> API Keys -> Private
VAPI_PRIVATE_KEY=
# Deployed base URL, no trailing slash, e.g. https://your-app.vercel.app
PUBLIC_BASE_URL=
# Printed by vapi:setup on first run; set it so later runs update in place.
VAPI_ASSISTANT_ID=

# --- Optional: dashboard niceties ------------------------------------------

# Vapi public/web key - safe in the browser. Enables the web-call button.
VAPI_PUBLIC_KEY=
# Displayed on the dashboard, e.g. +1 (555) 123-4567
PUBLIC_PHONE_NUMBER=
